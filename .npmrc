# Don't run install scripts from dependencies.
#
# Why: better-sqlite3 ships ready-made binaries for Windows/macOS/Linux, but when
# installing from package-lock.json, npm 10/11 wrongly tries to compile it from
# C++ source ("node-gyp rebuild"), which fails on machines without Visual Studio.
# None of our dependencies need an install script, so skipping them is safe.
# It also blocks a common supply-chain attack route (npm 12+ does this by default).
#
# `npm run dev` / `npm start` still work: scripts you run explicitly are unaffected.
ignore-scripts=true
