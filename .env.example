# Settings for the Hobbies Time Tracker server.
#
# Copy this file to ".env" in the same folder and fill it in:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# .env is git-ignored, so your secret key never gets committed.
# Leave both Supabase values empty to use the local SQLite file instead.

# Your project's URL, like https://abcdefghijklmnop.supabase.co
# (Supabase dashboard → Project Settings → Data API, or the "Connect" button)
SUPABASE_URL=

# The SECRET key (starts with sb_secret_), or the legacy "service_role" key.
# NOT the publishable / anon key: Row Level Security blocks that one.
# (Supabase dashboard → Project Settings → API Keys)
SUPABASE_SECRET_KEY=

# Optional: run the web server on a different port (default 3000)
# PORT=3000
